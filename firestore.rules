rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user document is keyed by mobile number.
    // Only the authenticated user whose email matches {mobile}@farmerledger.com
    // can read or write their own data.
    match /users/{mobile} {
      allow read, write: if request.auth != null
        && request.auth.token.email == (mobile + '@farmerledger.com');

      // Subcollections: ledger, custom_ledgers, plots, crops, notebook_farms
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.token.email == (mobile + '@farmerledger.com');

        // Nested subcollections (e.g. plots/{plotId}/crops/{cropId})
        match /{nestedCollection}/{nestedDocId} {
          allow read, write: if request.auth != null
            && request.auth.token.email == (mobile + '@farmerledger.com');
        }
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
